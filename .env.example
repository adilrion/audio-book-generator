# ─────────────────────────────────────────────────────────────
# PDF Audiobook — environment configuration
# Copy to .env and adjust. All values have sensible defaults.
# ─────────────────────────────────────────────────────────────

# Storage root (uploads, caches, outputs). Relative paths resolve from repo root.
STORAGE_DIR=./storage

# ── Infrastructure ───────────────────────────────────────────
# Docker Compose maps Postgres to 5433 so it doesn't clash with a local Postgres.app on 5432.
DATABASE_URL=postgresql://audiobook:audiobook@localhost:5433/audiobook?schema=public
REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
MAX_UPLOAD_MB=500

# ── Python worker ────────────────────────────────────────────
PYTHON_BIN=./workers/processing/.venv/bin/python

# ── Local LLM (Ollama) ───────────────────────────────────────
LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_MS=120000
# Opt-in: ask LLM to flag pronunciation-sensitive words (adds a respelling lexicon)
LLM_PRONUNCIATION=false

# ── TTS ──────────────────────────────────────────────────────
# kokoro | piper | say   (say = built-in macOS voices, zero install)
TTS_ENGINE=kokoro
TTS_DEFAULT_VOICE=af_heart
KOKORO_MODEL_PATH=./storage/models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=./storage/models/kokoro/voices-v1.0.bin
PIPER_MODEL_DIR=./storage/models/piper
TTS_SAMPLE_RATE=24000

# ── Video ────────────────────────────────────────────────────
# auto | h264_videotoolbox | libx264
VIDEO_ENCODER=auto
VIDEO_BITRATE=6M
VIDEO_CRF=20
VIDEO_FPS=30
AUDIO_ENCODER=auto
AUDIO_BITRATE=192k
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ── Resource limits (tuned for M4 / 16GB) ────────────────────
MAX_CONCURRENT_TTS=2
MAX_CONCURRENT_PDF_RENDER=2
MAX_CONCURRENT_LLM=1
MAX_CONCURRENT_PROJECTS=1
# Minimum free disk space kept in reserve (GB)
DISK_RESERVE_GB=3
# Keep rendered page images and video segments after success (false = clean them up)
KEEP_INTERMEDIATE=false

LOG_LEVEL=info
